"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"read":true,"user_title":null,"reply_to_user":{"id":3055,"username":"hao_zhang","name":"hao zhang","avatar_template":"/user_avatar/talk.nervos.org/hao_zhang/{size}/7824_2.png"},"bookmarked":false,"actions_summary":[{"id":2,"count":1}],"moderator":false,"admin":false,"staff":false,"user_id":3055,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/dao/11261/5","babel_translations_meta":[{"language":"en","status":"completed","source_language":"zh-tw"},{"language":"zh-cn","status":"completed","source_language":"zh-tw"},{"language":"es","status":"completed","source_language":"zh-tw"}],"show_translation_widget":true,"show_translation_button":true,"babel_detected_locale":"zh-tw","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":27589,"name":null,"username":"Fai","avatar_template":"/user_avatar/talk.nervos.org/fai/{size}/10354_2.png","created_at":"2026-11-19T15:01:23.972Z","cooked":"\u003cp\u003e我很想知道像这个巨无霸项目，多半年过去了情况如何？为什么没看到过它的进展汇报，那些为此项目活跃在社区的人，现在怎么都看不到呢\u003c/p\u003e\n\u003caside class=\"quote quote-modified\" data-post=\"1\" data-topic=\"9756\"\u003e\n  \u003cdiv class=\"title\"\u003e\n    \u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n    \u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://talk.nervos.org/user_avatar/talk.nervos.org/sonami/48/10369_2.png\" class=\"avatar\"\u003e\n    \u003cdiv class=\"quote-title__text-content\"\u003e\n      \u003ca href=\"https://talk.nervos.org/t/dis-ckb-integration-for-rosen-bridge/9756\"\u003e[DIS] CKB Integration for Rosen Bridge\u003c/a\u003e \u003ca class=\"badge-category__wrapper \" href=\"/c/daos-funding/ckb-community-fund-dao/65\"\u003e\u003cspan data-category-id=\"65\" style=\"--category-badge-color: #12A89D; --category-badge-text-color: #FFFFFF; --parent-category-badge-color: #F39C12;\" data-parent-category-id=\"73\" data-drop-close=\"true\" class=\"badge-category --style-square --has-parent\"\u003e\u003cspan class=\"badge-category__name\"\u003eCKB Community Fund DAO\u003c/span\u003e\u003c/span\u003e\u003c/a\u003e\n    \u003c/div\u003e\n  \u003c/div\u003e\n  \u003cblockquote\u003e\n    \u003ca name=\"p-21620-dis-ckb-integration-for-rosen-bridge-1\" class=\"anchor\" href=\"#p-21620-dis-ckb-integration-for-rosen-bridge-1\" aria-label=\"Heading link\"\u003e\u003c/a\u003e[DIS] CKB Integration for Rosen Bridge\nThis proposal has been \u003ca href=\"https://dao.ckb.community/thread/vot-ckb-integration-for-rosen-bridge-66568\" rel=\"noopener nofollow ugc\"\u003eposted for voting\u003c/a\u003e. \n\u003ca name=\"p-21620-summary-2\" class=\"anchor\" href=\"#p-21620-summary-2\" aria-label=\"Heading link\"\u003e\u003c/a\u003eSummary\nThis proposal is submitted to the Community Fund DAO to request grant funding to integrate CKB as a supported platform on Rosen Bridge using their Bridge Expansion Kit. \nETA to Completion: Q3-Q4 2026 \nGrant Amount: $65,000 USD (CKB price: $0.002376; CKB requested: 27,356,903) \nCKB Address (development team wallet): ckb1qzda0cr08m85hc8jlnfp3zer7xulejywt49kt2rr0vthywaa50xwsqtrrk2drsladgjuzg84d8czr8tpuzj27hsas…\n  \u003c/blockquote\u003e\n\u003c/aside\u003e\n\n\u003cp\u003e只看到投出的钱，而DAO项目后续有人在跟踪吗？我们是否需要一个为每个DAO项目辩护站台者的统计页面，以方便今后辨别其眼光和公信力？\u003c/p\u003e","post_number":6,"post_type":1,"posts_count":8,"updated_at":"2026-11-19T15:01:23.972Z","reply_count":2,"reply_to_post_number":null,"quote_count":0,"incoming_link_count":5,"reads":24,"readers_count":23,"score":114.8,"yours":false,"topic_id":11261,"topic_slug":"dao","display_username":null,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://talk.nervos.org/t/dis-ckb-integration-for-rosen-bridge/9756","internal":true,"reflection":false,"title":"[DIS] CKB Integration for Rosen Bridge","clicks":0},{"url":"https://talk.nervos.org/t/dis-ckb-integration-for-rosen-bridge/9756/153","internal":true,"reflection":true,"title":"[DIS] CKB Integration for Rosen Bridge","clicks":0}],"read":true,"user_title":null,"bookmarked":false,"actions_summary":[{"id":2,"count":3}],"moderator":false,"admin":false,"staff":false,"user_id":4125,"hidden":false,"trust_level":1,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/dao/11261/6","babel_translations_meta":[{"language":"en","status":"completed","source_language":"zh-cn"},{"language":"es","status":"completed","source_language":"zh-cn"}],"show_translation_widget":true,"show_translation_button":true,"babel_detected_locale":"zh-cn","reactions":[{"id":"heart","type":"emoji","count":3}],"current_user_reaction":null,"reaction_users_count":3,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":27592,"name":"zz_tovarishch","username":"zz_tovarishch","avatar_template":"/user_avatar/talk.nervos.org/zz_tovarishch/{size}/8925_2.png","created_at":"2026-11-19T16:13:33.814Z","cooked":"\u003cp\u003eHi Fai\u003c/p\u003e\n\u003caside class=\"quote no-group\" data-username=\"Fai\" data-post=\"6\" data-topic=\"11261\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://talk.nervos.org/user_avatar/talk.nervos.org/fai/48/10354_2.png\" class=\"avatar\"\u003e Fai:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003e只看到投出的钱，而DAO项目后续有人在跟踪吗？\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003e按照目前Community Fund DAO的规则，资助类提案如果有申请initial fund，那么在投票通过后，会由委员会进行打款。而后续里程碑支付则是按照项目提交Milestone 报告，依照以下规则，由社区进行审阅、提出问题。\u003c/p\u003e\n\u003caside class=\"quote no-group quote-modified\" data-username=\"JackyLHH\" data-post=\"1\" data-topic=\"6874\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://talk.nervos.org/user_avatar/talk.nervos.org/jackylhh/48/9804_2.png\" class=\"avatar\"\u003e\u003ca href=\"https://talk.nervos.org/t/ckb-community-fund-dao-rules-and-process/6874/1\"\u003eCKB Community Fund DAO Rules and Process\u003c/a\u003e\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cul\u003e\n\u003cli\u003e社区成员也有权监督申请团队的工作成效和资金使用情况，并在论坛中发表评论或进行讨论。\u003c/li\u003e\n\u003c/ul\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003e若里程碑报告提交后一段时间，社区没有更多意见后，委员会会进行里程碑款项的支付。因为现行规则中对于社区审阅的时长没有明确声明，所以在实践中社区审阅期按照2周进行，即里程碑报告提交后，若社区没有更多意见的时间达到2周，委员会会进行打款。\u003c/p\u003e\n\u003cp\u003e不可否认的是，现行规则有非常多改善的空间，期待大家的更多讨论、治理实践，乃至发起元规则提案。\u003c/p\u003e","post_number":7,"post_type":1,"posts_count":8,"updated_at":"2026-11-19T16:13:33.814Z","reply_count":0,"reply_to_post_number":6,"quote_count":1,"incoming_link_count":0,"reads":24,"readers_count":23,"score":4.8,"yours":false,"topic_id":11261,"topic_slug":"dao","display_username":"zz_tovarishch","primary_group_name":null,"flair_name":null,"flair_url":null,"flair_bg_color":null,"flair_color":null,"flair_group_id":null,"badges_granted":[],"version":1,"can_edit":false,"can_delete":false,"can_recover":false,"can_see_hidden_post":false,"can_wiki":false,"link_counts":[{"url":"https://talk.nervos.org/t/ckb-community-fund-dao-rules-and-process/6874","internal":true,"reflection":false,"title":"CKB Community Fund DAO Rules and Process","clicks":0}],"read":true,"user_title":"","bookmarked":false,"actions_summary":[],"moderator":true,"admin":false,"staff":true,"user_id":3420,"hidden":false,"trust_level":3,"deleted_at":null,"user_deleted":false,"edit_reason":null,"can_view_edit_history":true,"wiki":false,"post_url":"/t/dao/11261/7","babel_translations_meta":[{"language":"en","status":"completed","source_language":"zh-cn"},{"language":"es","status":"completed","source_language":"zh-cn"}],"show_translation_widget":true,"show_translation_button":true,"babel_detected_locale":"zh-cn","reactions":[],"current_user_reaction":null,"reaction_users_count":0,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":27598,"name":"Phroi","username":"phroi","avatar_template":"/user_avatar/talk.nervos.org/phroi/{size}/6171_2.png","created_at":"2026-11-19T18:34:41.740Z","cooked":"\u003caside class=\"quote no-group quote-modified\" data-username=\"Fai\" data-post=\"6\" data-topic=\"11261\"\u003e\n\u003cdiv class=\"title\"\u003e\n\u003cdiv class=\"quote-controls\"\u003e\u003c/div\u003e\n\u003cimg alt=\"\" width=\"24\" height=\"24\" src=\"https://talk.nervos.org/user_avatar/talk.nervos.org/fai/48/10354_2.png\" class=\"avatar\"\u003e Fai:\u003c/div\u003e\n\u003cblockquote\u003e\n\u003cp\u003eI’m really curious about how this massive project is doing after more than half a year?\u003c/p\u003e\n\u003c/blockquote\u003e\n\u003c/aside\u003e\n\u003cp\u003eHey \u003ca class=\"mention\" href=\"/u/fai\"\u003e@Fai\u003c/a\u003e, I \u003ca href=\"https://talk.nervos.org/t/dis-ckb-integration-for-rosen-bridge/9756/153\"\u003eanswered your comment\u003c/a\u003e in the Rosen integration thread, feel free to follow up over there!!\u003c/p\u003e\n\u003cp\u003e\u003cstrong\u003eTLDR\u003c/strong\u003e: as reported in the earlier Rosen update, the Rosen Team reviewed our design and found it sufficient, except for where Watchers and Guards read chain data. The integration is on hold 