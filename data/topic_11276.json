":"es","status":"completed","source_language":"en"}],"show_translation_widget":true,"show_translation_button":true,"babel_detected_locale":"en","reactions":[{"id":"heart","type":"emoji","count":1}],"current_user_reaction":null,"reaction_users_count":1,"current_user_used_main_reaction":false,"can_accept_answer":false,"can_unaccept_answer":false,"accepted_answer":false,"topic_accepted_answer":null,"can_translate":false},{"id":27677,"name":"zz_tovarishch","username":"zz_tovarishch","avatar_template":"/user_avatar/talk.nervos.org/zz_tovarishch/{size}/8925_2.png","created_at":"2026-11-21T03:41:23.999Z","cooked":"\u003cp\u003e我查询了一下Nervos Talk底层的Discourse文档\u003c/p\u003e\n\u003caside class=\"onebox allowlistedgeneric\" data-onebox-src=\"https://blog.discourse.org/2018/06/understanding-discourse-trust-levels/\"\u003e\n  \u003cheader class=\"source\"\u003e\n      \u003cimg src=\"https://talk.nervos.org/uploads/default/original/2X/5/5b44f83457f79bed4185a6116a25f95530bfccf1.png\" class=\"site-icon\" alt=\"\" data-dominant-color=\"706B53\" width=\"221\" height=\"221\"\u003e\n\n      \u003ca href=\"https://blog.discourse.org/2018/06/understanding-discourse-trust-levels/\" target=\"_blank\" rel=\"noopener\" title=\"12:00PM - 25 June 2018\"\u003eDiscourse – 25 Jun 18\u003c/a\u003e\n  \u003c/header\u003e\n\n  \u003carticle class=\"onebox-body\"\u003e\n    \u003cimg width=\"128\" height=\"128\" src=\"https://talk.nervos.org/uploads/default/original/2X/f/f35854ce3f1db2ae290595b7363577c955edc1d1.png\" class=\"thumbnail onebox-avatar\" alt=\"\" data-dominant-color=\"6B654A\"\u003e\n\n\u003ch3\u003e\u003ca href=\"https://blog.discourse.org/2018/06/understanding-discourse-trust-levels/\" target=\"_blank\" rel=\"noopener\"\u003eUnderstanding Discourse Trust Levels\u003c/a\u003e\u003c/h3\u003e\n\n  \u003cp\u003eThe user trust system is a fundamental cornerstone of Discourse. Trust levels are a way of…\u003c/p\u003e\n\n\n  \u003c/article\u003e\n\n  \u003cdiv class=\"onebox-metadata\"\u003e\n    \n    \n  \u003c/div\u003e\n\n  \u003cdiv style=\"clear: both\"\u003e\u003c/div\u003e\n\u003c/aside\u003e\n\n\u003cp\u003e似乎修改用户名的权限确实不在各个Level的授权中\u003c/p\u003e\n\u003chr\u003e\n\u003cp\u003e所以，如果您想修改您的用户名，或者可以告诉我（作为Mod），我来帮您修改\u003cbr\u003e\n\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://talk.nervos.org/uploads/default/original/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756.png\" data-download-href=\"https://talk.nervos.org/uploads/default/115093a1f6b8b93e08bcda58c7faabe5c7d52756\" title=\"image\"\u003e\u003cimg src=\"https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_409x499.png\" alt=\"image\" data-base62-sha1=\"2taKBLsRAmNBpScP81LrsTLrF42\" width=\"409\" height=\"499\" srcset=\"https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_409x499.png, https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_613x748.png 1.5x, https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_818x998.png 2x\" data-dominant-color=\"FBFBFB\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003eimage\u003c/span\u003e\u003cspan class=\"informations\"\u003e1092×1334 74.1 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":6,"updated_at":"2026-11-21T03:41:23.999Z","reply_count":1,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":0,"reads":9,"readers_count":8,"score":21.8,"yours":false,"topic_id":11276,"topic_slug":"how-can-we-change-username","display_username":"zz_tov