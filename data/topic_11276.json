\n    \n    \n  \u003c/div\u003e\n\n  \u003cdiv style=\"clear: both\"\u003e\u003c/div\u003e\n\u003c/aside\u003e\n\n\u003cp\u003e似乎修改用户名的权限确实不在各个Level的授权中\u003c/p\u003e\n\u003chr\u003e\n\u003cp\u003e所以，如果您想修改您的用户名，或者可以告诉我（作为Mod），我来帮您修改\u003cbr\u003e\n\u003cdiv class=\"lightbox-wrapper\"\u003e\u003ca class=\"lightbox\" href=\"https://talk.nervos.org/uploads/default/original/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756.png\" data-download-href=\"https://talk.nervos.org/uploads/default/115093a1f6b8b93e08bcda58c7faabe5c7d52756\" title=\"image\"\u003e\u003cimg src=\"https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_409x499.png\" alt=\"image\" data-base62-sha1=\"2taKBLsRAmNBpScP81LrsTLrF42\" width=\"409\" height=\"499\" srcset=\"https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_409x499.png, https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_613x748.png 1.5x, https://talk.nervos.org/uploads/default/optimized/2X/1/115093a1f6b8b93e08bcda58c7faabe5c7d52756_2_818x998.png 2x\" data-dominant-color=\"FBFBFB\"\u003e\u003cdiv class=\"meta\"\u003e\u003csvg class=\"fa d-icon d-icon-far-image svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#far-image\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003cspan class=\"filename\"\u003eimage\u003c/span\u003e\u003cspan class=\"informations\"\u003e1092×1334 74.1 KB\u003c/span\u003e\u003csvg class=\"fa d-icon d-icon-discourse-expand svg-icon\" aria-hidden=\"true\"\u003e\u003cuse href=\"#discourse-expand\"\u003e\u003c/use\u003e\u003c/svg\u003e\u003c/div\u003e\u003c/a\u003e\u003c/div\u003e\u003c/p\u003e","post_number":4,"post_type":1,"posts_count":6,"updated_at":"2026-11-21T03:41:23.999Z","reply_count":1,"reply_to_post_number":3,"quote_count":0,"incoming_link_count":0,"reads":14,"readers_count":13,"score":37.4,"yours":false,"topic_id":11276,"topic_slug":"how-can-we-change-username","display_username":"zz_t