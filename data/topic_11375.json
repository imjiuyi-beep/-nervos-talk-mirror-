r, an open directory and standing request for CKB-native ideas","id":10415,"title":"Introducing dir, an open directory and standing request for CKB-native ideas","slug":"introducing-dir-an-open-directory-and-standing-request-for-ckb-native-ideas","posts_count":6,"reply_count":3,"highest_post_number":6,"image_url":null,"created_at":"2026-06-24T03:18:25.089Z","last_posted_at":"2026-07-19T06:20:13.040Z","bumped":true,"bumped_at":"2026-07-19T06:20:13.040Z","archetype":"regular","unseen":false,"pinned":false,"unpinned":null,"visible":true,"closed":false,"archived":false,"bookmarked":null,"liked":null,"tags":[{"id":52,"name":"CKB","slug":"52-tag"},{"id":3,"name":"dapp","slug":"dapp"},{"id":383,"name":"lang-en","slug":"lang-en"}],"tags_descriptions":{},"like_count":20,"views":206,"category_id":69,"featured_link":null,"op_like_count":13,"has_accepted_answer":false,"posters":[{"extras":"latest","description":"Original Poster, Most Recent Poster","user":{"id":4238,"username":"truthixify","name":"truthixify","avatar_template":"/user_avatar/talk.nervos.org/truthixify/{size}/10972_2.png","trust_level":2}},{"extras":null,"description":"Recent Poster","user":{"id":4340,"username":"XBeach","name":"XBeach","avatar_template":"/user_avatar/talk.nervos.org/xbeach/{size}/11479_2.png","trust_level":1}},{"extras":null,"description":"Recent Poster","user":{"id":297,"username":"RetricSu","name":"Retric Su","avatar_template":"/user_avatar/talk.nervos.org/retricsu/{size}/715_2.png","trust_level":2}}]}],"tags":[{"id":353,"name":"fiber","slug":"fiber"},{"id":27,"name":"testnet","slug":"testnet"}],"tags_descriptions":{},"fancy_title":"Receive CKB on Fiber without a channel or inbound liquidity","id":11375,"title":"Receive CKB on Fiber without a channel or inbound liquidity","posts_count":1,"created_at":"2026-11-26T12:40:19.224Z","views":37,"reply_count":0,"like_count":6,"last_posted_at":"2026-11-26T12:40:19.312Z","visible":true,"closed":false,"archived":false,"has_summary":false,"archetype":"regular","slug":"receive-ckb-on-fiber-without-a-channel-or-inbound-liquidity","category_id":69,"word_count":792,"deleted_at":null,"user_id":4192,"featured_link":null,"pinned_globally":false,"pinned_at":null,"pinned_until":null,"image_url":null,"slow_mode_seconds":0,"draft":null,"draft_key":"topic_11375","draft_sequence":null,"unpinned":null,"pinned":false,"current_post_number":1,"highest_post_number":1,"deleted_by":null,"actions_summary":[{"id":4,"count":0,"hidden":false,"can_act":false},{"id":8,"count":0,"hidden":false,"can_act":false},{"id":10,"count":0,"hidden":false,"can_act":false},{"id":7,"count":0,"hidden":false,"can_act":false}],"chunk_size":20,"bookmarked":false,"topic_timer":null,"message_bus_last_id":23,"participant_count":1,"show_read_indicator":false,"thumbnails":null,"slow_mode_enabled_until":null,"summarizable":false,"has_cached_summary":false,"valid_reactions":["heart","+1","laughing","clap","confetti_ball","hugs","100","see_no_evil_monkey","hear_no_evil_monkey","speak_no_evil_monkey"],"has_accepted_answer":false,"can_create_shared_issue":false,"shared_issue_visible":false,"can_vote":false,"vote_count":0,"user_voted":false,"discourse_zendesk_plugin_zendesk_id":null,"discourse_zendesk_plugin_zendesk_url":"https://your-url.zendesk.com/agent/tickets/","details":{"can_edit":false,"notification_level":1,"participants":[{"id":4192,"username":"ebubedev","name":"Ebube Chukwuma","avatar_template":"/user_avatar/talk.nervos.org/ebubedev/{size}/10679_2.png","post_count":1,"primary_group_name":null,"flair_name":null,"flair_url":null,"flair_color":null,"flair_bg_color":null,"flair_group_id":null,"trust_level":1}],"created_by":{"id":4192,"username":"ebubedev","name":"Ebube Chukwuma","avatar_template":"/user_avatar/talk.nervos.org/ebubedev/{size}/10679_2.png"},"last_poster":{"id":4192,"username":"ebubedev","name":"Ebube Chukwuma","avatar_template":"/user_avatar/talk.nervos.org/ebubedev/{size}/10679_2.png"},"links":[{"url":"https://github.com/nervosnetwork/fiber/pull/1766","title":"feat: fund just-in-time CKB channels for receivers without a route by chukwuma619 · Pull Request #1766 · nervosnetwork/fiber · GitHub","internal":false,"attachment":false,"reflection":false,"clicks":4,"user_id":4192,"domain":"github.com","root_domain":"github.com"},{"url":"https://github.com/chukwuma619/fiber-studio/releases/tag/v1.1.6","title":"Release Fiber Studio v1.1.6 · chukwuma619/fiber-studio · GitHub","internal":false,"attachment":false,"reflection":false,"clicks":1,"user_id":4192,"domain":"github.com","root_domain":"github.com"}]},"bookmarks":[]}